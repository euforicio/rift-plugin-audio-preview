    "url": "https://github.com/braedonsaunders/bb-plugin-audio-preview/issues"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "audio",
    "preview",
    "m4a"
  ],
  "files": [
    "app.tsx",
    "server.ts",
    "lib",
    "components",
    "assets",
    "components.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "rift": ">=0.39",
    "riftPluginSdk": ">=0.4.48"
  },
  "rift": {
